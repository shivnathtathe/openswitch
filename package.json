{
  "name": "openswitch",
  "version": "0.2.0",
  "private": true,
  "description": "Desktop OpenVPN profile and connection manager",
  "productName": "OpenSwitch",
  "author": "Shivnath Tathe",
  "copyright": "Copyright (c) 2026 Shivnath Tathe",
  "homepage": "https://github.com/shivnathtathe/openswitch#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivnathtathe/openswitch.git"
  },
  "bugs": {
    "url": "https://github.com/shivnathtathe/openswitch/issues"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "clean": "rimraf dist release",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 dist/main/index.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run clean && npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "package": "npm run build && electron-builder --config electron-builder.yml --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "electron-store": "^7.0.3",
    "keytar": "^7.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^9.5.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
